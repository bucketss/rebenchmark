    { "name": "t2000a", "cvars": { "sys_ticrate": 2000 } },
    { "name": "t1300b", "cvars": { "sys_ticrate": 1300 } },
    { "name": "t2000b", "cvars": { "sys_ticrate": 2000 } },
    { "name": "t1300c", "cvars": { "sys_ticrate": 1300 } },
    { "name": "t2000c", "cvars": { "sys_ticrate": 2000 } }
  ],

  "teardown": ["sys_ticrate 1300"]
}
